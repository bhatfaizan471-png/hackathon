# ==============================================================================
# NEXUS OBSERVE — Collector Configuration Template
# ==============================================================================
# Instructions:
# 1. Rename or copy this file to .env:
#      copy settings.example.env .env
# 2. Fill in the values provided by your workspace administrator.
# 3. Never commit .env or share your COLLECTOR_KEY.
# ==============================================================================

# Tenant ID of your company/organization (required)
TENANT_ID=tenant_acme_demo

# Unique Collector ID assigned to this machine (required)
COLLECTOR_ID=col_demo_laptop_01

# Collector Secret Key (required)
COLLECTOR_KEY=your_secret_collector_key_here

# SaaS Ingest API Endpoint
# Default production SaaS URL:
SAAS_INGEST_URL=https://hackathon-2-09sm.onrender.com/v1/ingest

# Role / Classification for this host (e.g. employee_laptop, build_server, edge_node)
SOURCE_ROLE=employee_laptop

# Telemetry Send Interval in seconds (default: 5)
SEND_INTERVAL_SECONDS=5
