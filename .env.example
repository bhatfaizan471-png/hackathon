# Copy to .env. NEVER commit .env or any key file.

# --- Collector (Tier 1) ---
SAAS_INGEST_URL=http://localhost:8000/v1/ingest
COLLECTOR_ID=col_demo_laptop_01
COLLECTOR_KEY=change-me-per-collector-secret
TENANT_ID=tenant_acme_demo
SEND_INTERVAL_SECONDS=5
SOURCE_ROLE=employee_laptop

# --- Backend (Tier 2, Render) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to the Firebase Admin service account JSON (keep it out of git)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
WATCHDOG_OFFLINE_SECONDS=60

# --- Frontend (public Firebase web config; these are not secrets) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
